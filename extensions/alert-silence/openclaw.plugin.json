{
  "id": "alert-silence",
  "name": "Alert Silence",
  "description": "Batch-silence stale MySQL alerts by updating status to ignored.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "db": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "user": { "type": "string" },
          "password": { "type": "string" },
          "database": { "type": "string" }
        }
      },
      "defaultMinutes": {
        "type": "integer",
        "minimum": 1,
        "description": "Default time window in minutes for silencing alerts."
      }
    }
  }
}
